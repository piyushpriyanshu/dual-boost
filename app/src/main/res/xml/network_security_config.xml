<?xml version="1.0" encoding="utf-8"?>
<!-- The download booster must accept plain http:// links, like any download manager.
     Everything DualBoost itself talks to (updates, speed test, reports) is https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
