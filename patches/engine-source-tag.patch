diff --git a/src/hev-socks5-session-tcp.c b/src/hev-socks5-session-tcp.c
index a0475ab..9f9724f 100644
--- a/src/hev-socks5-session-tcp.c
+++ b/src/hev-socks5-session-tcp.c
@@ -8,6 +8,7 @@
  */
 
 #include <errno.h>
+#include <stdio.h>
 #include <string.h>
 
 #include <lwip/tcp.h>
@@ -274,6 +275,17 @@ hev_socks5_session_tcp_construct (HevSocks5SessionTCP *self,
     if (res < 0)
         return -1;
 
+    {
+        HevConfigServer *srv = hev_config_get_socks5_server ();
+        if (srv->user && srv->pass) {
+            snprintf (self->auth_user, sizeof (self->auth_user), "%s:t:%u:%s",
+                      srv->user, (unsigned)pcb->remote_port,
+                      ipaddr_ntoa (&pcb->remote_ip));
+            hev_socks5_client_set_auth (HEV_SOCKS5_CLIENT (self),
+                                        self->auth_user, srv->pass);
+        }
+    }
+
     LOG_D ("%p socks5 session tcp construct", self);
 
     HEV_OBJECT (self)->klass = HEV_SOCKS5_SESSION_TCP_TYPE;
